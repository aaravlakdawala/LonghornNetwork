digraph STATE_MACHINE {
  rankdir=LR;
  ranksep=0.6;
  nodesep=0.4;
  node [fontname="Arial", fontsize="8", style="filled"];
  edge [fontname="Arial", fontsize="7", labelfontsize="7"];
  bgcolor=white;

  "START" [label="START\nInitialize", shape="ellipse", fillcolor="#90EE90", color="black", penwidth=2];
  "LOAD_TEST_CASES" [label="Load Test Cases\n(TC1, TC2, TC3)", shape="box", fillcolor="#FFE4B5", color="black", penwidth=1.2, style="filled,rounded"];
  "LOOP_START" [label="For Each\nTest Case", shape="box", fillcolor="#FFDAB9", color="black", penwidth=1.2, style="filled,rounded"];
  "PARSE_DATA" [label="Parse & Display\nStudent Data", shape="box", fillcolor="#FFE4B5", color="black", penwidth=1.2, style="filled,rounded"];
  "BUILD_GRAPH" [label="Build\nStudentGraph", shape="box", fillcolor="#87CEEB", color="black", penwidth=1.2, style="filled,rounded"];
  "CHECK_RECIPROCAL" [label="Reciprocal\nEdges?", shape="diamond", fillcolor="#F0E68C", color="black", penwidth=1.5];
  "GRAPH_PASS" [label="✓ Graph Valid\n(+30 pts)", shape="box", fillcolor="#90EE90", color="black", penwidth=1.2, style="filled,rounded"];
  "GRAPH_FAIL" [label="✗ Graph Failed\n(+0 pts)", shape="box", fillcolor="#FFB6C6", color="black", penwidth=1.2, style="filled,rounded"];
  "RUN_MATCHING" [label="Run GaleShapley\nMatching", shape="box", fillcolor="#DDA0DD", color="black", penwidth=1.2, style="filled,rounded"];
  "VALIDATE_ROOMMATES" [label="Roommate\nPairs Valid?", shape="diamond", fillcolor="#F0E68C", color="black", penwidth=1.5];
  "MATCH_PASS" [label="✓ Matching Valid\n(+20 pts)", shape="box", fillcolor="#90EE90", color="black", penwidth=1.2, style="filled,rounded"];
  "MATCH_FAIL" [label="✗ Matching Failed\n(+0 pts)", shape="box", fillcolor="#FFB6C6", color="black", penwidth=1.2, style="filled,rounded"];
  "CHECK_SIZE" [label="students\nsize >= 2?", shape="diamond", fillcolor="#F0E68C", color="black", penwidth=1.5];
  "SIZE_FAIL" [label="✗ Not Enough\nStudents (+0 pts)", shape="box", fillcolor="#FFB6C6", color="black", penwidth=1.2, style="filled,rounded"];
  "CREATE_EXECUTOR" [label="Create Thread\nPool (4)", shape="box", fillcolor="#DDA0DD", color="black", penwidth=1.2, style="filled,rounded"];
  "SUBMIT_THREADS" [label="Submit 4 Tasks\n(FriendReq+Chat)", shape="box", fillcolor="#DDA0DD", color="black", penwidth=1.2, style="filled,rounded"];
  "WAIT_THREADS" [label="Wait for Threads\n(5s timeout)", shape="box", fillcolor="#DDA0DD", color="black", penwidth=1.2, style="filled,rounded"];
  "THREADS_PASS" [label="✓ Threads Done\n(+20 pts)", shape="box", fillcolor="#90EE90", color="black", penwidth=1.2, style="filled,rounded"];
  "THREADS_FAIL" [label="✗ Timeout/Error\n(+0 pts)", shape="box", fillcolor="#FFB6C6", color="black", penwidth=1.2, style="filled,rounded"];
  "BUILD_GRAPH2" [label="Build Graph\n(2nd time)", shape="box", fillcolor="#87CEEB", color="black", penwidth=1.2, style="filled,rounded"];
  "CREATE_FINDER" [label="Create\nReferralPathFinder", shape="box", fillcolor="#FFB6C1", color="black", penwidth=1.2, style="filled,rounded"];
  "SEARCH_REFERRAL" [label="Search for\nReferral Path", shape="box", fillcolor="#FFB6C1", color="black", penwidth=1.2, style="filled,rounded"];
  "CHECK_TC2" [label="Test Case\n== 2?", shape="diamond", fillcolor="#F0E68C", color="black", penwidth=1.5];
  "REFERRAL_PASS" [label="✓ Path Found\n(+10 pts)", shape="box", fillcolor="#90EE90", color="black", penwidth=1.2, style="filled,rounded"];
  "REFERRAL_FAIL" [label="✗ No Path\n(+0 pts)", shape="box", fillcolor="#FFB6C6", color="black", penwidth=1.2, style="filled,rounded"];
  "INTEGRATION" [label="Integration Tests\n(+20 pts)", shape="box", fillcolor="#90EE90", color="black", penwidth=1.2, style="filled,rounded"];
  "ADD_SCORE" [label="Add Score to\nTotal", shape="box", fillcolor="#DEB887", color="black", penwidth=1.2, style="filled,rounded"];
  "CHECK_LOOP" [label="i < 3?", shape="diamond", fillcolor="#F0E68C", color="black", penwidth=1.5];
  "LOOP_NEXT" [label="i++", shape="box", fillcolor="#FFDAB9", color="black", penwidth=1.2, style="filled,rounded"];
  "CALC_AVERAGE" [label="Calculate\nAverage Score", shape="box", fillcolor="#DEB887", color="black", penwidth=1.2, style="filled,rounded"];
  "OUTPUT_FINAL" [label="Output Final\nResults", shape="box", fillcolor="#D3D3D3", color="black", penwidth=1.2, style="filled,rounded"];
  "END" [label="END\nComplete", shape="ellipse", fillcolor="#90EE90", color="black", penwidth=2];

  "START" -> "LOAD_TEST_CASES" [color="black", penwidth=1.2];
  "LOAD_TEST_CASES" -> "LOOP_START" [label=" i=0", color="black", penwidth=1.2];
  "LOOP_START" -> "PARSE_DATA" [label=" get TC[i]", color="black", penwidth=1.2];
  "PARSE_DATA" -> "BUILD_GRAPH" [color="black", penwidth=1.2];
  "BUILD_GRAPH" -> "CHECK_RECIPROCAL" [color="black", penwidth=1.2];
  "CHECK_RECIPROCAL" -> "GRAPH_PASS" [label=" YES", color="green", penwidth=1.2];
  "CHECK_RECIPROCAL" -> "GRAPH_FAIL" [label=" NO", color="red", penwidth=1.2];
  "GRAPH_PASS" -> "RUN_MATCHING" [color="black", penwidth=1.2];
  "GRAPH_FAIL" -> "RUN_MATCHING" [color="black", penwidth=1.2];
  "RUN_MATCHING" -> "VALIDATE_ROOMMATES" [color="black", penwidth=1.2];
  "VALIDATE_ROOMMATES" -> "MATCH_PASS" [label=" YES", color="green", penwidth=1.2];
  "VALIDATE_ROOMMATES" -> "MATCH_FAIL" [label=" NO", color="red", penwidth=1.2];
  "MATCH_PASS" -> "CHECK_SIZE" [color="black", penwidth=1.2];
  "MATCH_FAIL" -> "CHECK_SIZE" [color="black", penwidth=1.2];
  "CHECK_SIZE" -> "CREATE_EXECUTOR" [label=" YES", color="green", penwidth=1.2];
  "CHECK_SIZE" -> "SIZE_FAIL" [label=" NO", color="red", penwidth=1.2];
  "SIZE_FAIL" -> "BUILD_GRAPH2" [color="black", penwidth=1.2];
  "CREATE_EXECUTOR" -> "SUBMIT_THREADS" [color="black", penwidth=1.2];
  "SUBMIT_THREADS" -> "WAIT_THREADS" [color="black", penwidth=1.2];
  "WAIT_THREADS" -> "THREADS_PASS" [label=" YES", color="green", penwidth=1.2];
  "WAIT_THREADS" -> "THREADS_FAIL" [label=" NO", color="red", penwidth=1.2];
  "THREADS_PASS" -> "BUILD_GRAPH2" [color="black", penwidth=1.2];
  "THREADS_FAIL" -> "BUILD_GRAPH2" [color="black", penwidth=1.2];
  "BUILD_GRAPH2" -> "CREATE_FINDER" [color="black", penwidth=1.2];
  "CREATE_FINDER" -> "SEARCH_REFERRAL" [color="black", penwidth=1.2];
  "SEARCH_REFERRAL" -> "CHECK_TC2" [color="black", penwidth=1.2];
  "CHECK_TC2" -> "REFERRAL_PASS" [label=" YES", color="green", penwidth=1.2];
  "CHECK_TC2" -> "REFERRAL_FAIL" [label=" NO", color="red", penwidth=1.2];
  "REFERRAL_PASS" -> "INTEGRATION" [color="green", penwidth=1.2];
  "REFERRAL_FAIL" -> "INTEGRATION" [color="green", penwidth=1.2];
  "INTEGRATION" -> "ADD_SCORE" [color="green", penwidth=1.2];
  "ADD_SCORE" -> "CHECK_LOOP" [color="black", penwidth=1.2];
  "CHECK_LOOP" -> "LOOP_NEXT" [label=" YES", color="green", penwidth=1.2];
  "CHECK_LOOP" -> "CALC_AVERAGE" [label=" NO", color="red", penwidth=1.2];
  "LOOP_NEXT" -> "LOOP_START" [color="black", penwidth=1.2];
  "CALC_AVERAGE" -> "OUTPUT_FINAL" [color="black", penwidth=1.2];
  "OUTPUT_FINAL" -> "END" [color="black", penwidth=1.2];
}